{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        { "type": "host", "value": "^(www\\.)?libassolapur\\.in$" }
      ],
      "status": 301,
      "headers": { "Location": "https://libassolapur.com/$1" }
    },
    {
      "src": "^/((?!user/).*)$",
      "dest": "/user/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/user/index.html"
    }
  ]
}
